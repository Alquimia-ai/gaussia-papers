# Secrets and environments
.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# The GRAG paper PDF is reference material (copyright), not versioned.
# Cited by URL in the README and in engines_grag.py.
Aclanthology
*.pdf

# HTML reports are regenerated from the JSON artifacts; not versioned.
*.html

# results/ is scratch for your own runs: ignored by default. BUT the CANONICAL
# artifacts are versioned, so the notebooks load real data right after cloning,
# with no API key needed.
results/*
!results/README.md

!results/level1_probes/
results/level1_probes/*
